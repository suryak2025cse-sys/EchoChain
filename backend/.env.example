# EchoChain Backend Environment Variables
PROJECT_NAME="EchoChain Provenance Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password_here"
POSTGRES_DB="echochain"
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres_password_here@localhost:5432/echochain"

# CORS Configuration (comma-separated or JSON list)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security & Secrets (Will be used in Phase 3+)
SECRET_KEY="supersecret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
