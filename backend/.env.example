# EchoChain Backend Environment Variables Example
PROJECT_NAME="EchoChain Provenance Platform"
ENVIRONMENT="production"
DEBUG=False
API_V1_STR="/api/v1"

# Security
SECRET_KEY="replace_with_a_secure_random_jwt_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend Base URL (used for QR code consumer verification links)
FRONTEND_URL="https://echochain.vercel.app"

# Database Configuration (Supabase PostgreSQL / External DB)
DATABASE_URL="postgresql://postgres:password@db.project.supabase.co:5432/postgres"

# Supabase Storage & Realtime Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# IPFS Pinata Configuration (Optional)
PINATA_API_KEY=""
PINATA_SECRET_API_KEY=""
PINATA_JWT=""

# Polygon Testnet Blockchain Configuration (Optional)
POLYGON_RPC_URL="https://rpc-amoy.polygon.technology"
POLYGON_PRIVATE_KEY=""
POLYGON_CONTRACT_ADDRESS="0x89205A3A3b2A69De6Dbf7f01ED13B2108B2c43e7"
